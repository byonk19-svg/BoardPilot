{
  "$defs": {
    "Construction": {
      "additionalProperties": false,
      "properties": {
        "panel_geometry": {
          "const": "butt_panels",
          "title": "Panel Geometry",
          "type": "string"
        },
        "back_style": {
          "const": "applied_full",
          "title": "Back Style",
          "type": "string"
        },
        "shelf_spacing": {
          "const": "equal_clear",
          "title": "Shelf Spacing",
          "type": "string"
        },
        "edge_banding": {
          "const": "none",
          "title": "Edge Banding",
          "type": "string"
        },
        "recipe": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecipeSelection"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "panel_geometry",
        "back_style",
        "shelf_spacing",
        "edge_banding",
        "recipe"
      ],
      "title": "Construction",
      "type": "object"
    },
    "Dimensions": {
      "additionalProperties": false,
      "properties": {
        "outside_width_mm": {
          "maxLength": 18,
          "title": "Outside Width Mm",
          "type": "string"
        },
        "outside_height_mm": {
          "maxLength": 18,
          "title": "Outside Height Mm",
          "type": "string"
        },
        "outside_depth_mm": {
          "maxLength": 18,
          "title": "Outside Depth Mm",
          "type": "string"
        },
        "fixed_shelf_count": {
          "maximum": 4,
          "minimum": 0,
          "title": "Fixed Shelf Count",
          "type": "integer"
        }
      },
      "required": [
        "outside_width_mm",
        "outside_height_mm",
        "outside_depth_mm",
        "fixed_shelf_count"
      ],
      "title": "Dimensions",
      "type": "object"
    },
    "Display": {
      "additionalProperties": false,
      "properties": {
        "preferred_unit": {
          "enum": [
            "in",
            "mm"
          ],
          "title": "Preferred Unit",
          "type": "string"
        },
        "fraction_denominator": {
          "enum": [
            16,
            32,
            64
          ],
          "title": "Fraction Denominator",
          "type": "integer"
        }
      },
      "required": [
        "preferred_unit",
        "fraction_denominator"
      ],
      "title": "Display",
      "type": "object"
    },
    "Documents": {
      "additionalProperties": false,
      "properties": {
        "paper_size": {
          "enum": [
            "letter",
            "a4"
          ],
          "title": "Paper Size",
          "type": "string"
        },
        "schedule_units": {
          "enum": [
            "dual",
            "mm"
          ],
          "title": "Schedule Units",
          "type": "string"
        },
        "native_part_drawing_units": {
          "const": "mm",
          "title": "Native Part Drawing Units",
          "type": "string"
        }
      },
      "required": [
        "paper_size",
        "schedule_units",
        "native_part_drawing_units"
      ],
      "title": "Documents",
      "type": "object"
    },
    "Manufacturing": {
      "additionalProperties": false,
      "properties": {
        "saw_kerf_mm": {
          "maxLength": 18,
          "title": "Saw Kerf Mm",
          "type": "string"
        },
        "rough_allowance_per_edge_mm": {
          "maxLength": 18,
          "title": "Rough Allowance Per Edge Mm",
          "type": "string"
        },
        "sheet_edge_trim_mm": {
          "maxLength": 18,
          "title": "Sheet Edge Trim Mm",
          "type": "string"
        },
        "stock_sheets": {
          "items": {
            "$ref": "#/$defs/StockSheet"
          },
          "maxItems": 12,
          "minItems": 0,
          "title": "Stock Sheets",
          "type": "array"
        }
      },
      "required": [
        "saw_kerf_mm",
        "rough_allowance_per_edge_mm",
        "sheet_edge_trim_mm",
        "stock_sheets"
      ],
      "title": "Manufacturing",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "properties": {
        "material_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Material Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "const": "plywood",
          "title": "Kind",
          "type": "string"
        },
        "nominal_label": {
          "maxLength": 80,
          "title": "Nominal Label",
          "type": "string"
        },
        "actual_thickness_mm": {
          "maxLength": 18,
          "title": "Actual Thickness Mm",
          "type": "string"
        },
        "face_grain": {
          "enum": [
            "along_L",
            "none"
          ],
          "title": "Face Grain",
          "type": "string"
        }
      },
      "required": [
        "material_id",
        "name",
        "kind",
        "nominal_label",
        "actual_thickness_mm",
        "face_grain"
      ],
      "title": "Material",
      "type": "object"
    },
    "Materials": {
      "additionalProperties": false,
      "properties": {
        "main": {
          "$ref": "#/$defs/Material"
        },
        "back": {
          "$ref": "#/$defs/Material"
        }
      },
      "required": [
        "main",
        "back"
      ],
      "title": "Materials",
      "type": "object"
    },
    "RecipeSelection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "RecipeSelection",
      "type": "object"
    },
    "StockSheet": {
      "additionalProperties": false,
      "properties": {
        "stock_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Stock Id",
          "type": "string"
        },
        "material_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Material Id",
          "type": "string"
        },
        "length_mm": {
          "maxLength": 18,
          "title": "Length Mm",
          "type": "string"
        },
        "width_mm": {
          "maxLength": 18,
          "title": "Width Mm",
          "type": "string"
        },
        "grain_axis": {
          "enum": [
            "length",
            "none"
          ],
          "title": "Grain Axis",
          "type": "string"
        },
        "unit_price": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Price"
        },
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "stock_id",
        "material_id",
        "length_mm",
        "width_mm",
        "grain_axis",
        "unit_price",
        "currency"
      ],
      "title": "StockSheet",
      "type": "object"
    },
    "Template": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "plywood_bookcase_v1",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "const": "1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Template",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Project Name",
      "type": "string"
    },
    "template": {
      "$ref": "#/$defs/Template"
    },
    "display": {
      "$ref": "#/$defs/Display"
    },
    "dimensions": {
      "$ref": "#/$defs/Dimensions"
    },
    "materials": {
      "$ref": "#/$defs/Materials"
    },
    "construction": {
      "$ref": "#/$defs/Construction"
    },
    "manufacturing": {
      "$ref": "#/$defs/Manufacturing"
    },
    "documents": {
      "$ref": "#/$defs/Documents"
    }
  },
  "required": [
    "schema_version",
    "project_name",
    "template",
    "display",
    "dimensions",
    "materials",
    "construction",
    "manufacturing",
    "documents"
  ],
  "title": "ProjectSpec",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:woodworking-planner:project-spec:1.0.0"
}
